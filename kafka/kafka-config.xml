<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 1. Настройка клиента для подключения к кластеру-получателю (Ignite B) -->
    <bean id="client.cfg" class="org.apache.ignite.configuration.ClientConfiguration">
        <!-- Адреса узлов кластера-получателя (тонкий клиент) -->
        <property name="addresses">
            <list>
                <value>ignite-node-b-1:10810</value>
<!--                <value>ignite-node-a-1:47500..47509</value>-->
<!--                <value>ignite-node-a-2:47500..47509</value>-->
<!--                <value>ignite-node-a-3:47500..47509</value>-->
            </list>
        </property>
        <!-- Таймауты подключения -->
        <property name="connectionTimeout" value="10000"/>
    </bean>

