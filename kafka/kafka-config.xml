    <!-- 2. Настройки Consumer для Kafka -->
    <util:properties id="kafkaProperties">
        <prop key="bootstrap.servers">kafka-host:9092</prop>
        <prop key="group.id">ignite_cdc_applier_group</prop>
        <prop key="auto.offset.reset">earliest</prop>
        <prop key="enable.auto.commit">false</prop>
        <prop key="key.deserializer">org.apache.kafka.common.serialization.ByteArrayDeserializer</prop>
        <prop key="value.deserializer">org.apache.kafka.common.serialization.ByteArrayDeserializer</prop>
    </util:properties>

    <!-- 3. Основная конфигурация стримера -->
    <bean class="org.apache.ignite.cdc.kafka.KafkaToIgniteCdcStreamerConfiguration">
        <!-- Имена топиков -->
        <property name="topic" value="ignite_cdc_data"/>
        <property name="metadataTopic" value="ignite_cdc_meta"/>

        <!-- Список кэшей для применения изменений -->
        <property name="cacheNames">
            <list>
                <value>CDC_TEST1</value>
            </list>
        </property>

        <!-- Внедрение настроек клиента и Kafka -->
        <property name="igniteConfiguration" ref="client.cfg"/>
        <property name="kafkaProperties" ref="kafkaProperties"/>

        <!-- Доп. настройки: максимальное количество записей за одну итерацию -->
        <property name="maxPollRecords" value="500"/>
    </bean>
</beans>