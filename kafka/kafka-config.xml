<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/util
            http://www.springframework.org/schema/util/spring-util.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <!-- 2. Настройки Consumer для Kafka -->
    <util:properties id="kafkaProperties">
        <prop key="bootstrap.servers">kafka:9092</prop>
        <prop key="group.id">ignite_cdc_applier_group_2</prop>
        <prop key="auto.offset.reset">earliest</prop>
        <prop key="enable.auto.commit">false</prop>
        <prop key="request.timeout.ms">10000</prop>
        <!--        <prop key="key.deserializer">org.apache.kafka.common.serialization.ByteArrayDeserializer</prop>-->
        <!--        <prop key="value.deserializer">org.apache.kafka.common.serialization.ByteArrayDeserializer</prop>-->
    </util:properties>

    <!-- 3. Основная конфигурация стримера -->
    <bean id="streamer.cfg" class="org.apache.ignite.cdc.kafka.KafkaToIgniteCdcStreamerConfiguration">
        <!-- Имена топиков -->
        <property name="topic" value="ignite_cdc_data_2"/>
        <property name="metadataTopic" value="ignite_cdc_meta_2"/>
        <property name="kafkaPartsFrom" value="0"/>
        <property name="kafkaPartsTo" value="3"/>
        <property name="threadCount" value="1"/>

        <!-- Список кэшей для применения изменений -->
        <property name="caches">
            <list>
                <value>CDC_TEST1</value>
            </list>
        </property>

        <!--        &lt;!&ndash; Доп. настройки: максимальное количество записей за одну итерацию &ndash;&gt;-->
        <!--        <property name="maxBatchSize" value="1024"/>-->
    </bean>

    <bean id="ignIgniteConfiguration" class="org.apache.ignite.configuration.IgniteConfiguration">
        <property name="discoverySpi" ref="ignTcpDiscoverySpi"/>
        <property name="clientMode" value="true"/>
        <property name="consistentId" value="cdc-streamer-from-2-to-1"/>
        <!--        <property name="consistentId" value="cdc-streamer-from-1-to-2"/>-->
        <!--        <property name="cacheConfiguration">-->
        <!--            <list>-->
        <!--                <bean class="org.apache.ignite.configuration.CacheConfiguration">-->
        <!--                    <property name="atomicityMode" value="ATOMIC"/>-->
        <!--                    <property name="name" value="CDC_TEST1"/>-->
        <!--                </bean>-->
        <!--            </list>-->
        <!--        </property>-->
    </bean>

    <!--TcpDiscoverySpi-->
    <bean id="ignTcpDiscoverySpi" class="org.apache.ignite.spi.discovery.tcp.TcpDiscoverySpi">
        <property name="ipFinder">
            <bean class="org.apache.ignite.spi.discovery.tcp.ipfinder.vm.TcpDiscoveryVmIpFinder">
                <!--                <property name="addresses" value="ignite-node-b-1:47500..47509"/>-->
                <property name="addresses">
                    <list>
                        <value>ignite-node-a-1:47500..47509</value>
                        <value>ignite-node-a-2:47500..47509</value>
                        <value>ignite-node-a-3:47500..47509</value>
                    </list>
                </property>
            </bean>
        </property>

        <property name="joinTimeout" value="10000"/>
    </bean>

</beans>